        android:icon="@drawable/tvlogo512px"
        android:label="@string/app_name"
        android:roundIcon="@drawable/tvlogo512px"
        android:supportsRtl="true"
        android:theme="@style/Theme.StreamingApp"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".presentation.view.SeriesLandscapePlayerScreenActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".presentation.view.SeriesPlayerScreenActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.TvLandscapeActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".presentation.view.ParentalControlActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.ContactActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.EditProfileActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.ActorScreenActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.SeriesScreenActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.FullScreenImageActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.MovieScreenActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.PickVideoTypeActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.PickGenresActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.view.SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.SelectLoginActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.view.MainActivity"
            android:exported="false">

