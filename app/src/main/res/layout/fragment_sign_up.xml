<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blmain"
    tools:context=".presentation.view.SignUpFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mainglTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mainglBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.98" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mainglLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.02" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mainglRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.98" />



    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/dimens_100"
        android:layout_height="@dimen/dimens_100"
        android:layout_margin="10dp"
        android:src="@drawable/tvlogo512px"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_margin="10dp"
        android:lineSpacingExtra="10dp"
        android:text="Sign Up to Create Account"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogo"
        />


    <EditText
        android:id="@+id/nameEdt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:textStyle="bold"
        android:gravity="start|center"
        android:inputType="textEmailAddress"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:padding="10dp"
        android:hint="Name"
        android:textColorHint="@color/iconColor"
        android:drawableStart="@drawable/person24px"
        android:drawableTint="@color/iconColor"
        android:drawablePadding="10dp"
        android:background="@drawable/lgtransparentlgblackstroke_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>


    <EditText
        android:id="@+id/emailEdt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:textStyle="bold"
        android:gravity="start|center"
        android:inputType="textEmailAddress"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:padding="10dp"
        android:hint="Email"
        android:textColorHint="@color/iconColor"
        android:drawableStart="@drawable/email24px"
        android:drawableTint="@color/iconColor"
        android:drawablePadding="10dp"
        android:background="@drawable/lgtransparentlgblackstroke_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nameEdt"/>

    <EditText
        android:id="@+id/passwordEdt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:textStyle="bold"
        android:gravity="start|center"
        android:inputType="textPassword"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:padding="10dp"
        android:hint="Password"
        android:textColorHint="@color/iconColor"
        android:drawableStart="@android:drawable/ic_lock_lock"
        android:drawableTint="@color/iconColor"
        android:drawablePadding="10dp"
        android:background="@drawable/lgtransparentlgblackstroke_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emailEdt"/>


    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/btnRemember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Remember me"
        android:textColor="@color/grey"
        app:buttonTint="@color/bluemain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passwordEdt"/>



    <Button
        android:id="@+id/btnSignUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:textStyle="bold"
        android:text="Sign Up"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:padding="10dp"
        android:backgroundTint="@color/bluemain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRemember"
        />


    <LinearLayout
        android:id="@+id/llOr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/btnSignUp"
        >

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/grey"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:text="or continue with"
            android:textColor="@color/grey"
            />


        <com.google.android.material.divider.MaterialDivider
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/grey"/>

    </LinearLayout>




    <ImageView
        android:id="@+id/ivGoogleSigUp"
        android:layout_width="64dp"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:padding="5dp"
        android:src="@drawable/google64px"
        android:background="@drawable/lgtransparentlgblackstroke_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llOr"/>







    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_margin="30dp"
        app:layout_constraintTop_toBottomOf="@+id/ivGoogleSigUp"
        app:layout_constraintBottom_toTopOf="@+id/mainglBottom"
        app:layout_constraintStart_toStartOf="@+id/mainglLeft"
        app:layout_constraintEnd_toStartOf="@+id/mainglRight">

        <TextView
            android:id="@+id/newUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_margin="5dp"
            android:text="Already have an account?"
            android:textSize="14sp"
            android:textColor="@color/iconColor"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_margin="5dp"
            android:layout_toRightOf="@+id/newUser"
            android:text="Sign in"
            android:textSize="14sp"
            android:textColor="@color/bluemain"
            android:textStyle="bold"/>


    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>