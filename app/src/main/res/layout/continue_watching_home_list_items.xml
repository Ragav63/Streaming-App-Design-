<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:id="@+id/itemll"
    tools:ignore="UseAppTint"
    android:orientation="vertical">


    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/dimens_200"
        android:layout_height="@dimen/dimens_100"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="@android:color/transparent">



        <ImageView
            android:id="@+id/conWatch_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:src="@drawable/strangerthings1"
            android:scaleType="matrix"
            android:adjustViewBounds="true"
            android:foreground="@drawable/combined_top_gradient"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/playIv"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/conWatchTitle_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Venom 3"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/conWatchDesc_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Venom 3"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/iconColor" />
            </LinearLayout>

        </LinearLayout>





    </androidx.cardview.widget.CardView>


    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/conWatchPbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="3dp"
        android:progress="50"
        android:progressDrawable="@drawable/progress_rounded"
        android:background="@null"
      />



</LinearLayout>