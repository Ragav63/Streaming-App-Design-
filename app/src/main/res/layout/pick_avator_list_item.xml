<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimens_150"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="10dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/lgblackmain"
    app:cardCornerRadius="20dp"
    android:id="@+id/cvRoot"
    tools:ignore="UseAppTint"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <ImageView
        android:id="@+id/selectIV"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="5dp"
        android:elevation="8dp"
        android:layout_gravity="end|top|center"
        android:src="@drawable/tickcircleblack64px"
        android:contentDescription="@string/select"
        android:visibility="invisible"
        android:tint="@android:color/transparent"
       />

    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/spart"
        android:contentDescription="@string/avatar"
        android:scaleType="fitXY"
        android:layout_margin="0.1dp"
        />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="Movies"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:padding="4dp"
        android:background="@drawable/dimcircle_bg"
        />



</com.google.android.material.card.MaterialCardView>