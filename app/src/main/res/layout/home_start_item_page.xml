<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:foreground="@drawable/combined_top_gradient"
 >


        <ImageView
            android:id="@+id/homeIV"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/deadpool"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"
            />


        <RelativeLayout
            android:id="@+id/playIv"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="30dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:elevation="5dp"
            android:background="@drawable/lgtrsbluecircle_bg"
            app:layout_constraintBottom_toTopOf="@+id/hometitleTv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            >

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_margin="5dp"
                    android:padding="2dp"
                    android:elevation="8dp"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@color/bluemain"
                    tools:ignore="UseAppTint" />

        </RelativeLayout>


        <TextView
            android:id="@+id/hometitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:elevation="8dp"
            android:gravity="start"
            android:text="Deadpool"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:padding="4dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/yearTv"
            />


        <TextView
            android:id="@+id/yearTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:layout_marginBottom="15dp"
            android:gravity="center"
            android:text="2022"
            android:textStyle="bold"
            android:textColor="@color/bluemain"
            android:textSize="12sp"
            android:elevation="8dp"
            android:background="@drawable/lgtransparentgreystroke_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/genreTv"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/genreTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:layout_marginBottom="15dp"
            android:gravity="center"
            android:text="Action"
            android:textStyle="bold"
            android:textColor="@color/bluemain"
            android:textSize="12sp"
            android:elevation="8dp"
            android:background="@drawable/lgtransparentbluestroke_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/originTv"
            app:layout_constraintStart_toEndOf="@+id/yearTv"/>

        <TextView
            android:id="@+id/originTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:layout_marginBottom="15dp"
            android:gravity="center"
            android:text="USA"
            android:textStyle="bold"
            android:textColor="@color/bluemain"
            android:textSize="12sp"
            android:elevation="8dp"
            android:background="@drawable/lgtransparentbluestroke_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/genreTv"
            app:layout_constraintEnd_toEndOf="parent"/>













</androidx.constraintlayout.widget.ConstraintLayout>