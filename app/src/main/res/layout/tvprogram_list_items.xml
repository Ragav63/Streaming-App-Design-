<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:id="@+id/itemll"
    android:layout_margin="5dp"
    android:orientation="horizontal">


    <androidx.cardview.widget.CardView
        android:id="@+id/tvProgramCv"
        android:layout_width="@dimen/dimens_100"
        android:layout_height="@dimen/dimens_70"
        android:layout_gravity="center"
        android:layout_margin="5dp"
        app:cardBackgroundColor="@android:color/transparent">



        <ImageView
            android:id="@+id/programIv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="0.4dp"
            android:layout_gravity="center"
            android:src="@drawable/avatarhz"
            android:scaleType="fitXY"
            />


    </androidx.cardview.widget.CardView>




    <TextView
        android:id="@+id/tvProgramName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="1dp"
        android:gravity="start|center"
        android:padding="10dp"
        android:text="11:45"
        android:maxLines="3"
        android:ellipsize="end"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="@color/white"/>

    <TextView
        android:id="@+id/tvLogoName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center"
        android:elevation="4dp"
        android:padding="5dp"
        android:text="ESPN"
        android:textColor="@color/red"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/blackcircle_bg"/>



</LinearLayout>