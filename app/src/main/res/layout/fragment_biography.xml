<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="4dp"
    tools:context=".presentation.view.BiographyFragment">

    <com.webtoonscorp.android.readmore.ReadMoreTextView
        android:id="@+id/actorDetailsTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:readMoreMaxLines="6"
        app:readMoreText="View More"
        app:readLessText="View Less"
        app:readMoreTextColor="@color/bluemain"
        app:readLessTextColor="@color/bluemain"
        android:textSize="12sp"
        android:textColor="@color/iconColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <TextView
        android:id="@+id/photosTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="5dp"
        android:layout_gravity="center"
        android:gravity="start|center"
        android:text="Photos"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actorDetailsTv"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recVBiographyPhotos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:listitem="@layout/biography_photos_list_items"
        android:orientation="horizontal"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="10dp"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/photosTv"/>



</androidx.constraintlayout.widget.ConstraintLayout>