<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="UseAppTint"
    android:fitsSystemWindows="true"
    tools:context=".presentation.view.OnBoardingFragment">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onbViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/llDotIndicator"
        />


    <LinearLayout
        android:id="@+id/llDotIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnLoginRegister"/>


    <Button
        android:id="@+id/btnLoginRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:text="Login &amp; Registration"
        android:elevation="8dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/bluemain"
        app:layout_constraintBottom_toTopOf="@+id/btnTryGuest"
        />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnTryGuest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="25dp"
        android:text="Try as guest"
        android:textAllCaps="false"
        android:elevation="8dp"
        android:textColor="@color/white"
        android:background="@drawable/lgtransparentbluestroke_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>