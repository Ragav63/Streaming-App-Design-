<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_botttom</item>
    </style>

    <!-- PopupMenuHelper Animation for Landscape TV Fragment (from right) -->

    <!-- In res/values/styles.xml -->

    <style name="SpinnerDropDownItemStyle" parent="TextAppearance.AppCompat.Widget.DropDownItem">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:minHeight">2dp</item>
        <item name="android:maxHeight">2dp</item>
        <item name="android:progressDrawable">@drawable/playersbar_progress_drawable</item>
        <item name="android:thumb">@drawable/thumb_sbar</item>
    </style>

    <style name="PopupTransparent" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:popupBackground">@color/semitransparent</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="FullRoundedButton">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>


    <style name="ModeChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>

        <!-- makes 2 chips per row -->
        <item name="android:layout_weight">1</item>

        <!-- Rounded edges -->
        <item name="chipCornerRadius">20dp</item>

        <!-- Colors -->
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>

        <!-- Remove icon & stroke -->
        <item name="chipIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>

        <!-- Center text -->
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
    </style>

</resources>