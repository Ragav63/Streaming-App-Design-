<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_botttom</item>
    </style>

    <!-- PopupMenuHelper Animation for Landscape TV Fragment (from right) -->

    <!-- In res/values/styles.xml -->

    <style name="SpinnerDropDownItemStyle" parent="TextAppearance.AppCompat.Widget.DropDownItem">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:minHeight">2dp</item>
        <item name="android:maxHeight">2dp</item>
        <item name="android:progressDrawable">@drawable/playersbar_progress_drawable</item>
        <item name="android:thumb">@drawable/thumb_sbar</item>
    </style>

    <style name="PopupTransparent" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:popupBackground">@color/semitransparent</item>
        <item name="android:textColor">@color/white</item>
    </style>


</resources>