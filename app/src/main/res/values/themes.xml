<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.StreamingApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Draws system bar backgrounds properly -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/bluemain</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/blmain</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Disable translucency completely -->
        <item name="android:windowIsTranslucent">false</item>
    </style>



    <style name="Theme.StreamingApp" parent="Base.Theme.StreamingApp" />
    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

</resources>